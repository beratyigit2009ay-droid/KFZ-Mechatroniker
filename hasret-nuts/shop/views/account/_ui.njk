{%- elif name == 'bag' -%}<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
{%- elif name == 'key' -%}<circle cx="8" cy="15" r="4"/><path d="M11 12l8.5-8.5M16 7l2.5 2.5M14 9l2 2"/>
{%- elif name == 'lock' -%}<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2"/>
{%- elif name == 'trash' -%}<path d="M4.5 7h15"/><path d="M9.5 7V4.8h5V7"/><path d="M6.5 7l1 13h9l1-13"/>
{%- elif name == 'logout' -%}<path d="M14 4.5H6.5A1.5 1.5 0 0 0 5 6v12a1.5 1.5 0 0 0 1.5 1.5H14"/><path d="M10 12h10M16.5 8.5L20 12l-3.5 3.5"/>
{%- elif name == 'mail' -%}<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7.5l8 6 8-6"/>
{%- elif name == 'mail-open' -%}<path d="M3.5 10l8.5-6 8.5 6v9a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19z"/><path d="M4 10.5l8 5.5 8-5.5"/>
{%- elif name == 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
{%- elif name == 'check-circle' -%}<circle cx="12" cy="12" r="8.5"/><path d="M8.2 12.3l2.6 2.6 5-5.2"/>
{%- elif name == 'info' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>
{%- elif name == 'warn' -%}<path d="M12 4l9 16H3z"/><path d="M12 10v4.5M12 17.5h.01"/>
{%- elif name == 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
{%- elif name == 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == 'back' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
{%- elif name == 'chev' -%}<path d="M9 6l6 6-6 6"/>
{%- elif name == 'chev-down' -%}<path d="M6 9l6 6 6-6"/>
{%- elif name == 'eye' -%}<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
{%- elif name == 'eye-off' -%}<path d="M4 4l16 16"/><path d="M10.6 6.1A9.6 9.6 0 0 1 12 6c6 0 9.5 6 9.5 6a16.4 16.4 0 0 1-2.9 3.6M6.6 7.6C4 9.4 2.5 12 2.5 12S6 18 12 18c1.5 0 2.9-.4 4.1-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
{%- elif name == 'grid' -%}<rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/>
{%- elif name == 'inbox' -%}<path d="M4 13.5l2.5-8h11l2.5 8V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19z"/><path d="M4 13.5h4.5l1 2h5l1-2H20"/>
{%- elif name == 'store' -%}<path d="M4 9.5L5.5 4h13L20 9.5"/><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"/><path d="M5.5 12v8h13v-8"/><path d="M10 20v-4.5h4V20"/>
{%- elif name == 'chat' -%}<path d="M5 5h14v10H9l-4 4z"/>
{%- elif name == 'bug' -%}<rect x="7" y="8" width="10" height="12" rx="5"/><path d="M12 8V5M9.5 5.5l-1.5-2M14.5 5.5l1.5-2M4 13h3M17 13h3M4.5 18l2.7-1.5M19.5 18l-2.7-1.5"/>
{%- elif name == 'idea' -%}<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.9V16h5v-.2c0-.8.4-1.5 1-1.9A6 6 0 0 0 12 3z"/>
{%- elif name == 'tag' -%}<path d="M3.5 12.2V4.5h7.7l9.3 9.3-7.7 7.7z"/><circle cx="8" cy="9" r="1.4"/>
{%- elif name == 'truck' -%}<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
{%- elif name == 'pin' -%}<path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>
{%- elif name == 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
{%- elif name == 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
{%- elif name == 'plus' -%}<path d="M12 5v14M5 12h14"/>
{%- elif name == 'users' -%}<circle cx="9" cy="8.5" r="3.3"/><path d="M3 19.5c1-3.3 3.4-5 6-5s5 1.7 6 5"/><path d="M15.5 5.6a3.3 3.3 0 0 1 0 6.1M17.5 14.8c1.6.6 2.8 2.1 3.5 4.7"/>
{%- elif name == 'spark' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/>
{%- elif name == 'external' -%}<path d="M14 5h5v5M19 5l-8 8"/><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>
{%- elif name == 'leaf' -%}<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>
{%- elif name == 'hand' -%}<path d="M8 12V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M11 10V4.5a1.5 1.5 0 0 1 3 0V11"/><path d="M14 10.5V6a1.5 1.5 0 0 1 3 0v7c0 4-2.5 7-6 7s-5.5-2-7-5l-1-2a1.5 1.5 0 0 1 2.6-1.5L8 13"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro chip(label, tone='new') -%}
<span class="st st--{{ tone }}"><span class="st__dot" aria-hidden="true"></span>{{ label }}</span>
{%- endmacro %}

{% macro pager(p, label='Seiten') -%}
{%- if p and p.pages > 1 -%}
<nav class="pager" aria-label="{{ label }}">
  {% if p.prev %}<a class="pager__btn" href="{{ p.prev }}" rel="prev">{{ icon('back', 18, 1.8) }}<span>Zurück</span></a>{% else %}<span class="pager__btn is-disabled" aria-hidden="true">{{ icon('back', 18, 1.8) }}<span>Zurück</span></span>{% endif %}
  <span class="pager__info">Seite {{ p.page }} von {{ p.pages }}{% if p.total %} · {{ p.from }}–{{ p.to }} von {{ p.total }}{% endif %}</span>
  {% if p.next %}<a class="pager__btn" href="{{ p.next }}" rel="next"><span>Weiter</span>{{ icon('arrow', 18, 1.8) }}</a>{% else %}<span class="pager__btn is-disabled" aria-hidden="true"><span>Weiter</span>{{ icon('arrow', 18, 1.8) }}</span>{% endif %}
</nav>
{%- endif -%}
{%- endmacro %}
