{#- Owner: BUILD-AUTH · UI-Bausteine für Konto, Anmeldung und Verwaltung.
    Import:  {% import "account/_ui.njk" as ui %}
      ui.icon(name, size, strokeWidth, cls)   Strich-Icon (Inline-SVG, aria-hidden) – gleiche Linienführung wie der Shop
      ui.chip(label, tone)                    Status-Chip (tone: new | work | ok | done | off)
      ui.pager(p, label)                      Seitennavigation ({ page, pages, prev, next, from, to, total })
-#}

{% macro icon(name, size=20, sw=1.6, cls='') -%}
<svg{% if cls %} class="{{ cls }}"{% endif %} width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
