{#- Owner: BUILD-AUTH · Passwort ändern. Variablen: errors -#}
{% extends "account/_layout.njk" %}
{% import "auth/_pw.njk" as pw with context %}
{% block accountContent %}
<div class="acct__section-head"><h1>Passwort ändern</h1></div>
<section class="acard" aria-label="Neues Passwort festlegen" style="max-width:640px">
  <p class="muted">Zur Sicherheit benötigen wir Ihr aktuelles Passwort. Nach dem Speichern bleiben Sie auf diesem Gerät angemeldet – auf allen anderen Geräten werden Sie abgemeldet.</p>
  {{ forms.errorSummary(errors) }}
  <form class="auth__form" method="post" action="/konto/passwort" novalidate data-once>
    {{ forms.csrf() }}
    <input type="text" name="username" value="{{ user.email }}" autocomplete="username" hidden aria-hidden="true" tabindex="-1">
    <div data-pw>{{ forms.field('currentPassword', 'Aktuelles Passwort', 'password', '', errors.currentPassword, { required: true, autocomplete: 'current-password', maxlength: 1024 }) }}</div>
    {{ pw.newPassword(errors, 'Neues Passwort', 'Neues Passwort wiederholen') }}
    <div class="ac-actions">
      <button type="submit" class="btn btn-dark">Neues Passwort speichern</button>
      <a class="link-btn" href="/konto/passwort-vergessen">Aktuelles Passwort vergessen?</a>
    </div>
  </form>
</section>
{% endblock %}
