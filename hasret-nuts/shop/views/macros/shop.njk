{#- Owner: BUILD-SHOP · Bausteine des Online-Shops.
    Import MIT Kontext (csrfToken, currentPath):  {% import "macros/shop.njk" as shop with context %}
      shop.icon(name, size, strokeWidth, cls)        Strich-Icon (Inline-SVG, aria-hidden)
      shop.photo(ph, cls, opts)                      Fotoplatzhalter mit Foto-ID, Seitenverhältnis, Mindestgröße, Motiv
      shop.card(c, h)                                Produktkarte (Bild A/B-Hover, Preis, In den Warenkorb)
      shop.crumbs(items)                             Brotkrumen
      {% call shop.acc(id, title, open, kind, h) %}…{% endcall %}   Akkordeon (Slide-Down)
      shop.newsletter(id)                            Newsletter-Band (Double-Opt-in)
      shop.coupon(c)                                 Coupon-Karte mit „Code kopieren“
-#}

