{% macro photo(ph, cls='', opts={}) -%}
<figure class="photo{% if cls %} {{ cls }}{% endif %}" data-photo="{{ ph.id }}" style="--ar:{{ ph.ar }}"{% if opts.decorative or not ph.alt %} aria-hidden="true"{% else %} role="img" aria-label="{{ ph.alt }}"{% endif %}{% if opts.attrs %} {{ opts.attrs | safe }}{% endif %}>
  {{ icon('cam', 22, 1.4, 'photo__icon') }}
  <figcaption><span class="photo__label">{{ ph.label }}</span><span class="photo__text">{{ ph.text }}</span></figcaption>
</figure>
{%- endmacro %}

{% macro buyInner(label='In den Warenkorb') -%}
{{ icon('bag', 18, 1.8, 'i-bag') }}{{ icon('check', 18, 2, 'i-check') }}<span class="buy__label">{{ label }}</span>
{%- endmacro %}

{% macro card(c, h='h3', opts={}) -%}
<article class="card" data-slug="{{ c.slug }}">
  <div class="card__media">
    <a class="m" href="{{ c.href }}" tabindex="-1" aria-hidden="true">
      {{ photo(c.photoA, 'ia', { decorative: true }) }}
      {{ photo(c.photoB, 'ib photo--b', { decorative: true }) }}
      {% if c.badge %}<span class="badge">{{ c.badge }}</span>{% endif %}
    </a>
    <div class="card__dots" role="group" aria-label="Bilder: {{ c.name }}">
      <button type="button" class="dot" data-dot="a" aria-pressed="true" aria-label="Packshot zeigen"></button>
      <button type="button" class="dot" data-dot="b" aria-pressed="false" aria-label="Detailbild zeigen"></button>
    </div>
  </div>
  <div class="card__body">
    <{{ h }} class="card__name"><a href="{{ c.href }}">{{ c.name }}</a></{{ h }}>
    <span class="card__sub">{{ c.subtitle }}</span>
    <div class="price"><strong>{{ c.priceLabel }}</strong><span>{{ c.basePriceLabel }}</span></div>
  </div>
  {% if not c.available %}
  <p class="card__na">Derzeit nicht verfügbar</p>
  {% elif c.directSku %}
  <form class="card__form" method="post" action="/warenkorb/hinzufuegen" data-add-form>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="sku" value="{{ c.directSku }}">
    <input type="hidden" name="qty" value="1">
    <input type="hidden" name="next" value="{{ currentPath }}">
    <input type="hidden" name="back" value="{{ currentPath }}">
    <button type="submit" class="btn buy card__buy" aria-label="{{ c.name }} in den Warenkorb legen">{{ buyInner() }}</button>
  </form>
  {% elif c.isBundle %}
  <a class="btn btn-o card__buy" href="{{ c.href }}" aria-label="{{ c.name }}: Trio zusammenstellen">Trio zusammenstellen</a>
  {% else %}
  <a class="btn btn-o card__buy" href="{{ c.href }}" aria-label="{{ c.name }}: {{ c.chooseLabel }}">{{ c.chooseLabel }} {{ icon('arrow', 16, 1.8) }}</a>
  {% endif %}
</article>
{%- endmacro %}

{% macro crumbs(items) -%}
<nav class="crumbs" aria-label="Brotkrumen">
  <ol>
  {% for it in items %}
    {% if loop.last %}<li><span aria-current="page">{{ it.name }}</span></li>
    {% else %}<li><a href="{{ it.href }}">{{ it.name }}</a><span class="crumbs__sep" aria-hidden="true">/</span></li>{% endif %}
  {% endfor %}
  </ol>
</nav>
{%- endmacro %}

{% macro acc(id, title, open=false, kind='filter', h='') -%}
<div class="acc{% if kind == 'pdp' %} acc--pdp acc--plus{% endif %}{% if open %} is-open{% endif %}" data-acc>
  {% if h %}<{{ h }} class="acc__h">{% endif %}<button type="button" class="acc__head" id="{{ id }}-h" aria-expanded="{{ 'true' if open else 'false' }}" aria-controls="{{ id }}"><span class="acc__title">{{ title }}</span>{{ icon('plus' if kind == 'pdp' else 'chev', 20 if kind == 'pdp' else 18, 1.8, 'acc__icon') }}</button>{% if h %}</{{ h }}>{% endif %}
  <div class="acc__panel" id="{{ id }}" role="region" aria-labelledby="{{ id }}-h"><div class="acc__inner">{{ caller() }}</div></div>
</div>
{%- endmacro %}

{% macro newsletter(id='newsletter') -%}
<section class="band-foam nl-band" id="{{ id }}" aria-labelledby="{{ id }}-h">
  <div class="nl reveal">
    <p class="eyebrow">Newsletter</p>
    <h2 id="{{ id }}-h">Neue Sorten, Messe-Termine und exklusive Vorteile.</h2>
    <p>Einmal anmelden, nichts verpassen: Wir schreiben Ihnen, wenn es neue Spezialitäten gibt, wann Sie uns auf der nächsten Messe treffen – und gelegentlich mit Rabattcodes, die es nur für Abonnentinnen und Abonnenten gibt.</p>
    <form class="nl__form" method="post" action="/newsletter" data-nl-form novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="hp-field" aria-hidden="true"><label for="{{ id }}-hp">Dieses Feld bitte leer lassen</label><input type="text" id="{{ id }}-hp" name="website" value="" tabindex="-1" autocomplete="off"></div>
      <label for="{{ id }}-mail" class="sr-only">E-Mail-Adresse</label>
      <input id="{{ id }}-mail" class="nl__input" type="email" name="email" placeholder="Ihre E-Mail-Adresse" autocomplete="email" required maxlength="254" aria-describedby="{{ id }}-msg {{ id }}-legal">
      <button type="submit" class="btn btn--lg btn-dark">Anmelden</button>
    </form>
    <p class="nl__msg" id="{{ id }}-msg" data-nl-msg role="status" tabindex="-1"></p>
    <small id="{{ id }}-legal">Mit Ihrer Anmeldung willigen Sie ein, dass wir Ihnen gelegentlich E-Mails zu neuen Sorten, Messe-Terminen und Angeboten senden. Sie erhalten zuerst eine E-Mail zur Bestätigung (Double-Opt-in). Abmeldung jederzeit über den Link in jeder E-Mail oder unter <a href="/newsletter/abmelden">Newsletter abmelden</a>. Details in unserer <a href="/datenschutz#newsletter">Datenschutzerklärung</a>.</small>
  </div>
</section>
{%- endmacro %}

{% macro coupon(c, headingLevel='h3') -%}
<article class="coupon" data-coupon>
  <div class="coupon__value">
    <span class="coupon__amount">{{ c.value }}</span>
    <span class="coupon__kind">{{ 'Rabatt' if c.type == 'percent' else 'Nachlass' }}</span>
  </div>
  <div class="coupon__body">
    <p class="eyebrow">{{ c.label }}</p>
    <{{ headingLevel }} class="coupon__title">{{ c.headline }}</{{ headingLevel }}>
    <p class="coupon__text">{{ c.text }}</p>
    <div class="coupon__code">
      <span class="sr-only">Rabattcode:</span>
      <input class="coupon__input" type="text" value="{{ c.code }}" readonly aria-label="Rabattcode {{ c.code }}" data-copy-source spellcheck="false">
      <button type="button" class="btn btn-o coupon__copy" data-copy hidden>{{ icon('copy', 18, 1.6) }}<span data-copy-label>Code kopieren</span></button>
    </div>
    <ul class="coupon__conditions">
      {% for cond in c.conditions %}<li>{{ cond }}</li>{% endfor %}
    </ul>
  </div>
</article>
{%- endmacro %}

{% macro steps(current) -%}
<ol class="steps" aria-label="Fortschritt der Bestellanfrage">
  <li class="steps__item{% if current == 1 %} is-current{% elif current > 1 %} is-done{% endif %}"{% if current == 1 %} aria-current="step"{% endif %}><span class="steps__n">1</span><span>Warenkorb</span></li>
  <li class="steps__item{% if current == 2 %} is-current{% elif current > 2 %} is-done{% endif %}"{% if current == 2 %} aria-current="step"{% endif %}><span class="steps__n">2</span><span>Ihre Angaben</span></li>
  <li class="steps__item{% if current == 3 %} is-current{% endif %}"{% if current == 3 %} aria-current="step"{% endif %}><span class="steps__n">3</span><span>Anfrage gesendet</span></li>
</ol>
{%- endmacro %}

{% macro legalNote() -%}
<div class="note note--legal" role="note">
  {{ icon('info', 20, 1.6) }}
  <p><strong>Platzhalter – rechtlich prüfen lassen.</strong> Die endgültige Fassung wird vor der Veröffentlichung von einer Rechtsanwältin bzw. einem Rechtsanwalt erstellt oder geprüft. Angaben in eckigen Klammern werden ergänzt.</p>
</div>
{%- endmacro %}
