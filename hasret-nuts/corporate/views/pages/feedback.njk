{% extends "layout.njk" %}
{% import "macros/ui.njk" as ui %}
{% import "macros/fields.njk" as f %}
{% import "macros/forms.njk" as forms with context %}
{#- Feedback & Fehler melden (KONZEPT.md 4.5) – noindex. POST /feedback (routes/forms.js).
    Technische Angaben (Browser, Bildschirmgröße) werden NUR mit Häkchen und nur per
    JavaScript ergänzt (public/js/site.js · initFeedback). -#}

{% block content %}
<section aria-labelledby="feedback-title">
  <div class="wrap page-intro">
    <div class="page-intro__main">
      <p class="eyebrow eyebrow--line reveal">Ihre Meinung zählt</p>
      <h1 id="feedback-title" class="display-1 display-1--m reveal">Feedback &amp; <em>Fehler melden</em></h1>
    </div>
    <div class="page-intro__aside reveal">
      <p>Ihre Rückmeldung macht uns besser. Ob Lob, Kritik, eine Idee oder ein technischer Fehler: Wir lesen jede Nachricht persönlich.</p>
    </div>
  </div>

  <div class="wrap fb">
    <aside class="fb__aside reveal" aria-labelledby="fb-ablauf-title">
      <h2 id="fb-ablauf-title" class="eyebrow">So geht es weiter</h2>
      <ol class="fb__steps">
        <li><span class="fb__num" aria-hidden="true">01</span><strong>Sie schreiben uns</strong><span>Ein paar Sätze genügen. Bei einem Fehler helfen uns die Schritte, die dorthin geführt haben.</span></li>
        <li><span class="fb__num" aria-hidden="true">02</span><strong>Wir lesen persönlich</strong><span>Jede Nachricht landet direkt bei uns in Memmingen – nicht in einem Ticketsystem.</span></li>
        <li><span class="fb__num" aria-hidden="true">03</span><strong>Wir melden uns</strong><span>Wenn Sie uns Ihre E-Mail-Adresse nennen, fragen wir bei Bedarf nach oder geben Ihnen Bescheid.</span></li>
      </ol>
      <p class="body-m">Für Händleranfragen nutzen Sie bitte das <a class="text-link" href="/haendler#anfrage">Formular im Händlerbereich</a>.</p>
    </aside>

    <div class="form-card{% if not hasErrors and not success %} reveal{% endif %}" id="feedback-formular">
      {% if success %}
      <div class="success" role="status" data-focus-on-load>
        {{ ui.check() }}
        <h2 id="danke" tabindex="-1">Vielen Dank für Ihre Nachricht!</h2>
        <p>Wir kümmern uns darum. Wenn Sie uns Ihre E-Mail-Adresse genannt haben, melden wir uns bei Rückfragen.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/">Zur Startseite</a>
          <a class="btn btn--outline" href="/feedback">Weitere Nachricht</a>
        </div>
      </div>
      {% else %}
      <form class="form" id="feedback-form" method="post" action="/feedback#fehler" novalidate aria-labelledby="feedback-title" data-validate data-feedback>
        {{ forms.csrf() }}
        {{ forms.honeypot() }}
        {% if hasErrors %}<div class="error-anchor" id="fehler" tabindex="-1">{{ forms.errorSummary(errors, 'Bitte prüfen Sie die markierten Felder.') }}</div>{% endif %}

        <fieldset class="fieldset{% if errors.art %} is-invalid{% endif %}" aria-describedby="f-art-err">
          <legend>Worum geht es?<span aria-hidden="true"> *</span></legend>
          <div class="choices">
            {% for k in kinds %}
            <label class="choice" for="{{ 'f-art' if loop.first else ('f-art-' ~ k.value) }}">
              <input type="radio" id="{{ 'f-art' if loop.first else ('f-art-' ~ k.value) }}" name="art" value="{{ k.value }}"{% if values.art == k.value %} checked{% endif %}{% if loop.first %} required data-msg-missing="Bitte wählen Sie aus, worum es geht."{% endif %}>
              <span class="choice__box">
                {% if k.value == 'feedback' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/></svg>
                {% elif k.value == 'bug' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M12 3.5l9 16H3z"/><path d="M12 10v4.5M12 17v.4"/></svg>
                {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M9 17.5h6M10 20.5h4"/><path d="M12 3.5a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2v1h5v-1c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3.5z"/></svg>{% endif %}
                <span class="choice__title">{{ k.label }}</span>
                <span class="choice__hint">{{ k.hint }}</span>
              </span>
            </label>
            {% endfor %}
          </div>
          {{ f.err('art', errors.art) }}
        </fieldset>

        {{ f.textarea('nachricht', 'Ihre Nachricht', values.nachricht, errors.nachricht, { required: true, rows: 6, maxlength: 3000, placeholder: 'Was möchten Sie uns mitteilen?', msgMissing: 'Bitte schreiben Sie uns, was Sie uns mitteilen möchten.' }) }}

        {{ f.input('seite', 'Auf welcher Seite?', 'text', values.seite, errors.seite, { maxlength: 500, autocomplete: 'off', spellcheck: 'false', placeholder: 'z. B. /haendler', hint: ('Wir haben die zuletzt besuchte Seite eingetragen – bitte bei Bedarf anpassen.' if values.seite else 'Freiwillig – Adresse oder Name der Seite, um die es geht.') }) }}

        <div class="bug-fields" data-bug-fields data-collapsed="{{ 'false' if values.art == 'bug' else 'true' }}">
          <p class="bug-fields__title">Nur bei Fehlermeldungen</p>
          {{ f.textarea('schritte', 'Was haben Sie gemacht?', values.schritte, errors.schritte, { rows: 4, maxlength: 3000, placeholder: 'Zum Beispiel: Seite „Für Händler“ geöffnet, Formular ausgefüllt, auf „Anfrage senden“ geklickt …' }) }}
          {{ f.textarea('erwartet', 'Was hätten Sie erwartet?', values.erwartet, errors.erwartet, { rows: 3, maxlength: 2000, placeholder: 'Was sollte stattdessen passieren?' }) }}
        </div>

        <div class="fld">
          <label class="chk chk--consent" for="f-technik"><input type="checkbox" id="f-technik" name="technik" value="on"{% if values.technik %} checked{% endif %} aria-describedby="f-technik-hint"><span>Technische Angaben mitsenden</span></label>
          <p class="fld__hint" id="f-technik-hint">Browser, Betriebssystem und Bildschirmgröße – das hilft uns, einen Fehler nachzustellen. Wird nur mit Häkchen übertragen.</p>
          <input type="hidden" name="browser" id="f-browser" value="">
          <p class="tech-preview" data-tech-preview aria-live="polite" hidden></p>
        </div>

        {{ f.input('email', 'E-Mail-Adresse', 'email', values.email, errors.email, { autocomplete: 'email', inputmode: 'email', maxlength: 254, spellcheck: 'false', hint: 'Freiwillig – nur falls wir nachfragen dürfen.', msgInvalid: 'Bitte prüfen Sie die E-Mail-Adresse – zum Beispiel name@beispiel.de.' }) }}

        <p class="form__privacy">Ihre Angaben verwenden wir ausschließlich zur Bearbeitung Ihrer Rückmeldung. Mehr dazu in der <a class="text-link" href="/datenschutz#feedback">Datenschutzerklärung</a>.</p>
        <div class="form__foot">
          <span class="form__req">* Pflichtfelder</span>
          <button class="btn btn--primary" type="submit" data-busy-label="Wird gesendet …">Nachricht senden {{ ui.arrow() }}</button>
        </div>
      </form>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
