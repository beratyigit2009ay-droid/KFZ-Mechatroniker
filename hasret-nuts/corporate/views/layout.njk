{#- Owner: BUILD-CORPORATE · Grundlayout des Corporate Hub.
    Blöcke: title (in seo-head), meta, head, content, scripts.
    Variablen: meta, nonce, site, currentPath, flash, csrfToken (nur in Formularseiten ausgeben –
    das Ausgeben legt die Sitzung an), jsonLd (strukturierte Daten, optional), bodyClass. -#}
<!doctype html>
<html lang="de" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% set introPart = 'head' %}{% include "partials/intro.njk" %}
<script nonce="{{ nonce }}">document.documentElement.className=document.documentElement.className.replace(/\bno-js\b/,'js');</script>
{% block meta %}{% include "partials/seo-head.njk" %}{% endblock %}
<meta name="theme-color" content="#0E4B3B">
<meta name="format-detection" content="telephone=no">
<link rel="preload" href="/assets/fonts/cormorant-garamond/cormorant-garamond-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/jost/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ asset('/assets/css/fonts.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/motion/logo-spin.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/motion/nuts.css') }}">
<link rel="stylesheet" href="{{ asset('/static/css/site.css') }}">
{% if jsonLd %}
<script type="application/ld+json" nonce="{{ nonce }}">{{ jsonLd | jsonld }}</script>
{% endif %}
{% block head %}{% endblock %}
</head>
<body class="{{ bodyClass or 'page' }}">
{% set introPart = 'body' %}{% set introVariant = 'corporate' %}{% include "partials/intro.njk" %}
<div class="hdr-sentinel" aria-hidden="true"></div>
<a class="skip-link" href="#main">Zum Inhalt springen</a>

{% include "partials/header.njk" %}

<main id="main" tabindex="-1">
{% if flash and flash.length %}
<div class="wrap">{% include "partials/flash.njk" %}</div>
{% endif %}
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<script src="{{ asset('/assets/motion/nuts.js') }}" defer></script>
<script src="{{ asset('/static/js/site.js') }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
