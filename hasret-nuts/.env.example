# =============================================================================
#  Hasret Nuts – Umgebungsvariablen (Vorlage)
#  Kopieren nach ".env" und anpassen:   cp .env.example .env
#  In ".env" stehen Geheimnisse (SMTP-Passwort, LOG_SALT) – die Datei wird NIE
#  eingecheckt (.gitignore). Diese Vorlage enthält bewusst KEINE echten Werte.
#  Leere Werte = Standardwert (für die Entwicklung sinnvoll vorbelegt).
# =============================================================================

# --- Betriebsart -------------------------------------------------------------
# development (Standard) | production | test
# In "production" startet die App NUR, wenn HTTPS-URLs, SMTP, MAIL_FROM,
# OWNER_EMAIL und LOG_SALT korrekt gesetzt sind (Fail-fast).
NODE_ENV=development

# --- Netzwerk ----------------------------------------------------------------
# Adresse, an die sich die Node-Prozesse binden. Hinter einem Reverse Proxy
# (Caddy/nginx) unbedingt 127.0.0.1 lassen, damit die Apps nicht direkt
# aus dem Internet erreichbar sind.
HOST=127.0.0.1
# Ports der beiden Apps (Standard 3001 / 3002)
CORPORATE_PORT=3001
SHOP_PORT=3002

# Öffentliche Adressen (ohne abschließenden Schrägstrich). Werden für Canonical-
# Links, Sitemaps, Open Graph und Links in E-Mails verwendet.
# In Produktion Pflicht und zwingend https://, z. B.
#   CORPORATE_BASE_URL=https://www.ihre-domain.de
#   SHOP_BASE_URL=https://shop.ihre-domain.de
CORPORATE_BASE_URL=http://localhost:3001
SHOP_BASE_URL=http://localhost:3002

# Anzahl vertrauenswürdiger Reverse Proxys vor der App (für korrekte Client-IP
# bei Ratenlimits und Protokollierung). Ein Caddy/nginx auf demselben Server: 1
# (oder "loopback"). Ohne Proxy: false. "true" ist aus Sicherheitsgründen in
# Produktion nicht erlaubt (IP-Spoofing über X-Forwarded-For).
TRUST_PROXY=false

# --- Datenbank -----------------------------------------------------------------
# Pfad zur SQLite-Datei (relativ zum Projektordner oder absolut).
DATABASE_PATH=data/hasret.db

# --- Katalogdaten (nur ändern, wenn die JSON-Dateien woanders liegen) ----------
# CATALOG_PATH=shared/data/catalog.json
# ALLERGENS_PATH=shared/data/allergens.json
# OFFERS_PATH=shared/data/offers.json

# --- E-Mail ------------------------------------------------------------------
# Versandart: smtp | file | memory
#   Standard: production → smtp, development → file (Mails als .eml in MAIL_DIR,
#   der erste Link wird in der Konsole ausgegeben), test → memory.
MAIL_TRANSPORT=
# Ordner für Entwicklungs-Mails (.eml)
MAIL_DIR=var/mail
# Absender, Format: Name <adresse@domain>   (in Produktion Pflicht)
MAIL_FROM="Hasret Nuts <shop@ihre-domain.de>"
# Optionale Antwortadresse für alle ausgehenden Mails
MAIL_REPLY_TO=
# Empfänger für neue Bestellanfragen, Händleranfragen und Feedback (Inhaber)
# (in Produktion Pflicht)
OWNER_EMAIL=

# SMTP-Zugang Ihres E-Mail-Anbieters (in Produktion Pflicht: SMTP_HOST)
SMTP_HOST=
# 587 = STARTTLS (Standard, SMTP_SECURE=false) · 465 = TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Geheim! Nur in .env bzw. in der Umgebung des Servers hinterlegen.
SMTP_PASS=

# --- Sicherheit ----------------------------------------------------------------
# Geheimes Salz für das Hashen von IP-Adressen in Sicherheitsprotokollen
# (es werden niemals rohe IPs gespeichert). Mind. 32 zufällige Zeichen, in
# Produktion Pflicht. Erzeugen z. B. mit:   openssl rand -hex 32
LOG_SALT=

# Sitzungsdauer in Tagen (rollierend, Standard 14)
SESSION_TTL_DAYS=14
# Automatische Abmeldung von Administratoren nach Inaktivität in Minuten
# (Standard 30, 0 = aus)
ADMIN_IDLE_MINUTES=30

# Ratenlimits (optional). Pro Limit: RATE_LIMIT_<NAME>_MAX (Anzahl) und
# RATE_LIMIT_<NAME>_WINDOW_MIN (Zeitfenster in Minuten). Namen und Standardwerte:
#   GLOBAL 300/15 · LOGIN 10/15 · REGISTER 5/60 · FORGOT 5/60 · RESEND 3/60
#   FORMS 10/60 · DISCOUNT 20/10 · NEWSLETTER 5/60 · MAIL_PER_ADDRESS 3/60
# Beispiel:
# RATE_LIMIT_FORMS_MAX=10
# RATE_LIMIT_FORMS_WINDOW_MIN=60

# --- Suchmaschinen -------------------------------------------------------------
# Indexierung erlauben? Standard: nur in Produktion "true". Für eine
# Test-/Staging-Umgebung im Produktionsmodus auf false setzen
# (robots.txt sperrt dann alles, alle Seiten erhalten noindex).
ALLOW_INDEXING=
# Google Search Console – Inhalt des Meta-Tags "google-site-verification"
# (nur der Code, nicht das ganze Tag). Je Plattform eine eigene Property.
GOOGLE_SITE_VERIFICATION_CORPORATE=
GOOGLE_SITE_VERIFICATION_SHOP=

# --- Bestellungen --------------------------------------------------------------
# Präfix der Bestellnummern (z. B. HN → HN-2026-0001)
ORDER_PREFIX=HN

# --- Nur für "npm run create-admin" (einmalig, danach wieder entfernen!) --------
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
